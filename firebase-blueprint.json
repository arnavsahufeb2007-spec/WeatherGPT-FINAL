{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and personal meteorological preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "preferredLanguage": { "type": "string" },
        "temperatureUnit": { "type": "string", "enum": ["celsius", "fahrenheit"] }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SavedLocation": {
      "title": "SavedLocation",
      "description": "User's favorite weather locations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "country": { "type": "string" },
        "admin1": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "latitude", "longitude", "savedAt"]
    },
    "WeatherQuery": {
      "title": "WeatherQuery",
      "description": "Saved user weather query and AI response history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "query": { "type": "string" },
        "reply": { "type": "string" },
        "locationName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "query", "reply", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Stores user profile and preferences"
    },
    "/users/{userId}/savedLocations/{locationId}": {
      "schema": "#/entities/SavedLocation",
      "description": "Stores user saved favorite locations"
    },
    "/users/{userId}/queries/{queryId}": {
      "schema": "#/entities/WeatherQuery",
      "description": "Stores user weather query history"
    }
  }
}
