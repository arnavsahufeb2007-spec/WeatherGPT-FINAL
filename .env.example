# GEMINI_API_KEY: AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# GEMINI_MODEL: Model alias or name (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# WEATHER_PROVIDER: Weather API provider (defaults to open-meteo)
WEATHER_PROVIDER="open-meteo"

# ROUTING_PROVIDER: Routing provider (defaults to osrm)
ROUTING_PROVIDER="osrm"

# BHASHINI_ENABLED: Set to "true" to enable optional Bhashini Indian language pipeline integration
BHASHINI_ENABLED="false"

# BHASHINI_USER_ID: User ID from Bhashini / ULCA portal (optional)
BHASHINI_USER_ID=""

# BHASHINI_API_KEY: API Key from Bhashini / ULCA portal (optional)
BHASHINI_API_KEY=""

# BHASHINI_INFERENCE_API_KEY: Inference API Key for Dhruva pipeline (optional)
BHASHINI_INFERENCE_API_KEY=""

# BHASHINI_PIPELINE_URL: Bhashini Dhruva pipeline URL
BHASHINI_PIPELINE_URL="https://dhruva-api.bhashini.gov.in/services/inference/pipeline"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION (Auth, PostgreSQL Database & Row Level Security)
# ==============================================================================
# VITE_SUPABASE_URL: Your Supabase project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Public client-safe Supabase anonymous public API key
# Used by the frontend client with Row Level Security (RLS) policies
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Server-only secret key (OPTIONAL, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=""

