# Environment Variables Template for WeatherGPT

# GEMINI_API_KEY: Server-side Gemini API key for meteorological intelligence
GEMINI_API_KEY=

# GEMINI_MODEL: Model alias or name (e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# WEATHER_PROVIDER: Weather data provider (default: open-meteo)
WEATHER_PROVIDER=open-meteo

# ROUTING_PROVIDER: Travel route provider (default: osrm)
ROUTING_PROVIDER=osrm

# ==============================================================================
# ELEVENLABS AI VOICE RECOGNITION (STT) & SPEECH SYNTHESIS
# ==============================================================================
# ELEVENLABS_API_KEY: Secret key for ElevenLabs Scribe v2 STT and Multilingual TTS
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==============================================================================
# SARVAM AI BULBUL V3 TTS (Indian regional languages)
# ==============================================================================
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3

# ==============================================================================
# BHASHINI ULCA / DHRUVA PIPELINE (Optional Indian language pipeline)
# ==============================================================================
BHASHINI_ENABLED=false
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
