# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model alias or name (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# WEATHER_PROVIDER: Weather API provider (defaults to open-meteo)
WEATHER_PROVIDER="open-meteo"

# ROUTING_PROVIDER: Routing provider (defaults to osrm)
ROUTING_PROVIDER="osrm"

# BHASHINI_ENABLED: Set to "true" to enable optional Bhashini Indian language pipeline integration
BHASHINI_ENABLED="false"

# BHASHINI_USER_ID: User ID from Bhashini / ULCA portal (optional)
BHASHINI_USER_ID=""

# BHASHINI_API_KEY: API Key from Bhashini / ULCA portal (optional)
BHASHINI_API_KEY=""

# BHASHINI_INFERENCE_API_KEY: Inference API Key for Dhruva pipeline (optional)
BHASHINI_INFERENCE_API_KEY=""

# BHASHINI_PIPELINE_URL: Bhashini Dhruva pipeline URL
BHASHINI_PIPELINE_URL="https://dhruva-api.bhashini.gov.in/services/inference/pipeline"

# ENABLE_NASA_DATA: Set to "true" to enable NASA Earth observation & environmental intelligence layer
ENABLE_NASA_DATA="true"

# NASA_API_KEY: Optional NASA API key from api.nasa.gov for increased rate limits (defaults to public tier)
NASA_API_KEY=""

# NASA_FIRMS_MAP_KEY: Optional NASA FIRMS MAP_KEY for direct active fire hotspot data
NASA_FIRMS_MAP_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
